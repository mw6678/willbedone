DEFAULT_CONFIG = {

    "baudrate": 9600,

    "bytesize": 8,

    "parity": "N",

    "stopbits": 1,

    "timeout": 0.3,

    "line_ending": "\\n",

    "parser_mode": "auto",

    "channel_names": ["CH1", "CH2", "CH3", "CH4"],

    "channel_units": ["ppm", "ppm", "%LEL", "%vol"],

