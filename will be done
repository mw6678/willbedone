}





def load_config():

    if CONFIG_FILE.exists():

        try:

            saved = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))

            cfg = DEFAULT_CONFIG.copy()

            cfg.update(saved)

            return cfg

        except Exception:

            pass

    return DEFAULT_CONFIG.copy()





def save_config(config):

    CONFIG_FILE.write_text(

        json.dumps(config, ensure_ascii=False, indent=2),

        encoding="utf-8"

    )





class DataParser:

    """

    지원 예:

    1) 12.3,45.6,7.8,20.9

    2) CH1:12.3 CH2:45.6 CH3:7.8 CH4:20.9

    3) CO=12.3,H2S=4.5,LEL=7.8,O2=20.9

    4) 임의 문자열 안의 첫 번째 숫자 4개

    """



    NUMBER = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)"



    def __init__(self, mode="auto"):

        self.mode = mode



    def parse(self, line):

        text = line.strip()

        if not text:

            return None



        parsers = {

            "csv": self._parse_csv,

            "key_value": self._parse_key_value,

            "numbers": self._parse_numbers,

        }



        if self.mode in parsers:

            return parsers[self.mode](text)



        for fn in (self._parse_key_value, self._parse_csv, self._parse_numbers):

            values = fn(text)

            if values is not None:

                return values

        return None



    def _parse_csv(self, text):

        # 쉼표/세미콜론/탭으로 정확히 4개 값

        parts = [p.strip() for p in re.split(r"[,;\t]", text)]

        if len(parts) != 4:

            return None

        try:

            return [float(re.search(self.NUMBER, p).group()) for p in parts]

        except Exception:

            return None



    def _parse_key_value(self, text):

        # CH1:1.0, CH2=2.0 등 키-값 쌍에서 순서대로 4개

        pairs = re.findall(

            rf"([A-Za-z가-힣][A-Za-z0-9가-힣_%\-]*)\s*[:=]\s*({self.NUMBER})",

            text

        )

        if len(pairs) < 4:

            return None



        indexed = {}

        ordered = []

        for key, value in pairs:

            v = float(value)

            match = re.search(r"(?:CH|C)\s*([1-4])", key, re.IGNORECASE)

            if match:

                indexed[int(match.group(1)) - 1] = v

            ordered.append(v)



        if len(indexed) == 4:

            return [indexed[i] for i in range(4)]

        return ordered[:4]



    def _parse_numbers(self, text):

        values = re.findall(self.NUMBER, text)

        if len(values) < 4:

            return None

        return [float(v) for v in values[:4]]





class SerialWorker(threading.Thread):

    def __init__(self, port, serial_settings, output_queue, stop_event):

        super().__init__(daemon=True)

        self.port = port

        self.settings = serial_settings

        self.output_queue = output_queue

        self.stop_event = stop_event

        self.ser = None



    def run(self):

        try:

            self.ser = serial.Serial(

                port=self.port,

                baudrate=self.settings["baudrate"],

                bytesize=self.settings["bytesize"],

                parity=self.settings["parity"],

                stopbits=self.settings["stopbits"],

                timeout=self.settings["timeout"],

            )

            self.output_queue.put(("status", f"연결됨: {self.port}"))

            buffer = b""



            while not self.stop_event.is_set():

                chunk = self.ser.read(self.ser.in_waiting or 1)

                if not chunk:

                    continue

                buffer += chunk



                # CR/LF 모두 처리

                while b"\n" in buffer or b"\r" in buffer:

                    match = re.search(b"[\r\n]+", buffer)

                    if not match:

                        break

                    line = buffer[:match.start()]

                    buffer = buffer[match.end():]

                    if line:

                        text = line.decode("utf-8", errors="replace").strip()

                        self.output_queue.put(("line", text))



        except Exception as exc:

            self.output_queue.put(("error", str(exc)))

        finally:

            if self.ser and self.ser.is_open:

                self.ser.close()

            self.output_queue.put(("status", "연결 해제됨"))





class GasMonitorApp(tk.Tk):

    def __init__(self):

        super().__init__()

        self.title(APP_TITLE)

        self.geometry("1380x850")

        self.minsize(1120, 720)



        self.config_data = load_config()

        self.rx_queue = queue.Queue()

        self.stop_event = threading.Event()

        self.worker = None

        self.parser = DataParser(self.config_data["parser_mode"])



        self.current_values = [None] * 4

        self.min_values = [None] * 4

        self.max_values = [None] * 4

        points = int(self.config_data["graph_points"])

        self.time_data = deque(maxlen=points)

        self.channel_data = [deque(maxlen=points) for _ in range(4)]

        self.start_time = time.time()



        self.logging_enabled = False

        self.log_file = None

        self.log_writer = None

        self.last_log_time = 0.0



        self._build_ui()

        self.refresh_ports()

        self.after(100, self.process_queue)

        self.protocol("WM_DELETE_WINDOW", self.on_close)



    def _build_ui(self):

        top = ttk.Frame(self, padding=10)

        top.pack(fill="x")



        # AlphaGas 로고

        logo_path = Path(__file__).with_name("alphagas_logo.png")

        if logo_path.exists():

            logo_image = Image.open(logo_path).convert("RGBA")

            logo_image.thumbnail((180, 54), Image.Resampling.LANCZOS)

            self.logo_photo = ImageTk.PhotoImage(logo_image)

            ttk.Label(top, image=self.logo_photo).pack(side="left", padx=(0, 14))



        ttk.Label(top, text="COM 포트").pack(side="left")

        self.port_var = tk.StringVar()

        self.port_combo = ttk.Combobox(top, width=16, textvariable=self.port_var, state="readonly")

        self.port_combo.pack(side="left", padx=(6, 8))



        ttk.Button(top, text="새로고침", command=self.refresh_ports).pack(side="left")



        ttk.Label(top, text="Baud").pack(side="left", padx=(18, 0))

        self.baud_var = tk.StringVar(value=str(self.config_data["baudrate"]))

        ttk.Combobox(

            top,

            width=10,

            textvariable=self.baud_var,

            values=["1200", "2400", "4800", "9600", "19200", "38400", "57600", "115200"],

        ).pack(side="left", padx=6)



        ttk.Label(top, text="파서").pack(side="left", padx=(18, 0))

        self.parser_var = tk.StringVar(value=self.config_data["parser_mode"])

        ttk.Combobox(

            top,

            width=12,

            textvariable=self.parser_var,

            state="readonly",

            values=["auto", "csv", "key_value", "numbers"],

        ).pack(side="left", padx=6)



        self.connect_btn = ttk.Button(top, text="연결", command=self.toggle_connection)

        self.connect_btn.pack(side="left", padx=(12, 4))



        ttk.Button(top, text="채널 설정", command=self.open_settings).pack(side="left", padx=4)

        self.log_btn = ttk.Button(top, text="CSV 기록 시작", command=self.toggle_logging)

        self.log_btn.pack(side="left", padx=4)

        ttk.Button(top, text="최소/최대 초기화", command=self.reset_minmax).pack(side="left", padx=4)



        self.status_var = tk.StringVar(value="대기 중")

        ttk.Label(top, textvariable=self.status_var).pack(side="right")



        cards = ttk.Frame(self, padding=(10, 0, 10, 8))

        cards.pack(fill="x")



        self.value_vars = []

        self.minmax_vars = []

        self.alarm_labels = []

        self.card_frames = []



        for i in range(4):

            card = ttk.LabelFrame(cards, text=self.config_data["channel_names"][i], padding=12)

            card.grid(row=0, column=i, sticky="nsew", padx=5)

            cards.columnconfigure(i, weight=1)

            self.card_frames.append(card)



            value_var = tk.StringVar(value="--")

            self.value_vars.append(value_var)

            ttk.Label(card, textvariable=value_var, font=("Arial", 27, "bold")).pack()



            unit_label = ttk.Label(card, text=self.config_data["channel_units"][i], font=("Arial", 12))

            unit_label.pack()

            card.unit_label = unit_label



            minmax_var = tk.StringVar(value="MIN --  |  MAX --")

            self.minmax_vars.append(minmax_var)

            ttk.Label(card, textvariable=minmax_var).pack(pady=(8, 4))



            alarm = tk.Label(card, text="NORMAL", bg="#2e7d32", fg="white", padx=16, pady=4)

            alarm.pack()

            self.alarm_labels.append(alarm)



        middle = ttk.Panedwindow(self, orient="horizontal")

        middle.pack(fill="both", expand=True, padx=10, pady=5)



        graph_frame = ttk.LabelFrame(middle, text="실시간 농도 변화 그래프", padding=8)

        terminal_frame = ttk.LabelFrame(middle, text="수신 원문 / 파싱 상태", padding=8)

        middle.add(graph_frame, weight=4)

        middle.add(terminal_frame, weight=2)



        self.figure = Figure(figsize=(8, 5), dpi=100)

        self.axes = self.figure.add_subplot(111)

        self.axes.set_xlabel("Time (s)")

        self.axes.set_ylabel("Value")

        self.axes.grid(True, alpha=0.3)

        self.plot_lines = []

        for i in range(4):

            line, = self.axes.plot([], [], label=self.config_data["channel_names"][i])

            self.plot_lines.append(line)

        self.axes.legend(loc="upper left")

        self.canvas = FigureCanvasTkAgg(self.figure, master=graph_frame)

        self.canvas.get_tk_widget().pack(fill="both", expand=True)



        self.terminal = tk.Text(terminal_frame, width=42, height=25, wrap="none")

        terminal_scroll = ttk.Scrollbar(terminal_frame, command=self.terminal.yview)

        self.terminal.configure(yscrollcommand=terminal_scroll.set)

        self.terminal.pack(side="left", fill="both", expand=True)

        terminal_scroll.pack(side="right", fill="y")



        bottom = ttk.Frame(self, padding=10)

        bottom.pack(fill="x")

        self.parsed_var = tk.StringVar(value="정상 파싱: 0 / 실패: 0")

        self.rx_count = 0

        self.fail_count = 0

        ttk.Label(bottom, textvariable=self.parsed_var).pack(side="left")

        ttk.Label(

            bottom,

            text="지원 형식: 1,2,3,4  |  CH1:1 CH2:2 CH3:3 CH4:4  |  문자열 내 숫자 4개"

        ).pack(side="right")



    def refresh_ports(self):

        ports = [p.device for p in serial.tools.list_ports.comports()]

        self.port_combo["values"] = ports

        if ports and self.port_var.get() not in ports:

            self.port_var.set(ports[0])

        if not ports:

            self.port_var.set("")



    def toggle_connection(self):

        if self.worker and self.worker.is_alive():

            self.disconnect_serial()

        else:

            self.connect_serial()



    def connect_serial(self):

        port = self.port_var.get().strip()

        if not port:

            messagebox.showwarning("포트 선택", "사용할 COM 포트를 선택해 주세요.")

            return

        try:

            baudrate = int(self.baud_var.get())

        except ValueError:

            messagebox.showerror("설정 오류", "Baud rate가 올바르지 않습니다.")

            return



        self.config_data["baudrate"] = baudrate

        self.config_data["parser_mode"] = self.parser_var.get()

        self.parser = DataParser(self.parser_var.get())

        save_config(self.config_data)



        self.stop_event.clear()

        serial_settings = {

            "baudrate": baudrate,

            "bytesize": int(self.config_data.get("bytesize", 8)),

            "parity": self.config_data.get("parity", "N"),

            "stopbits": float(self.config_data.get("stopbits", 1)),

            "timeout": float(self.config_data.get("timeout", 0.3)),

        }

        self.worker = SerialWorker(port, serial_settings, self.rx_queue, self.stop_event)

        self.worker.start()

        self.connect_btn.config(text="연결 해제")



    def disconnect_serial(self):

        self.stop_event.set()

        self.connect_btn.config(text="연결")



    def process_queue(self):

        try:

            while True:

                kind, payload = self.rx_queue.get_nowait()

                if kind == "line":

                    self.handle_line(payload)

                elif kind == "status":

                    self.status_var.set(payload)

                    if "해제" in payload:

                        self.connect_btn.config(text="연결")

                elif kind == "error":

                    messagebox.showerror("시리얼 오류", payload)

                    self.status_var.set(f"오류: {payload}")

                    self.connect_btn.config(text="연결")

        except queue.Empty:

            pass

        self.after(100, self.process_queue)



    def handle_line(self, line):

        timestamp = datetime.now().strftime("%H:%M:%S.%f")[:-3]

        values = self.parser.parse(line)



        self.terminal.insert("end", f"[{timestamp}] {line}\n")

        if values is None:

            self.fail_count += 1

            self.terminal.insert("end", "  ↳ 파싱 실패\n")

        else:

            self.rx_count += 1

            self.update_values(values)

            self.terminal.insert("end", f"  ↳ {values}\n")

            self.write_log_if_needed(values)



        self.parsed_var.set(f"정상 파싱: {self.rx_count} / 실패: {self.fail_count}")

        self.terminal.see("end")



        # 메모리 과다 사용 방지

        if int(self.terminal.index("end-1c").split(".")[0]) > 2000:

            self.terminal.delete("1.0", "500.0")



    def update_values(self, values):

        elapsed = time.time() - self.start_time

        self.time_data.append(elapsed)



        for i, value in enumerate(values[:4]):

            self.current_values[i] = value

            self.channel_data[i].append(value)



            if self.min_values[i] is None or value < self.min_values[i]:

                self.min_values[i] = value

            if self.max_values[i] is None or value > self.max_values[i]:

                self.max_values[i] = value



            self.value_vars[i].set(f"{value:.3f}".rstrip("0").rstrip("."))

            self.minmax_vars[i].set(

                f"MIN {self.min_values[i]:.3f}  |  MAX {self.max_values[i]:.3f}"

            )



            low = float(self.config_data["alarm_low"][i])

            high = float(self.config_data["alarm_high"][i])

            if value < low:

                self.set_alarm(i, "LOW ALARM", "#1565c0")

            elif value >= high:

                self.set_alarm(i, "HIGH ALARM", "#c62828")

            else:

                self.set_alarm(i, "NORMAL", "#2e7d32")



        self.redraw_graph()



    def set_alarm(self, index, text, bg):

        self.alarm_labels[index].config(text=text, bg=bg)



    def redraw_graph(self):

        if not self.time_data:

            return

        x = list(self.time_data)

        for i, line in enumerate(self.plot_lines):

            y = list(self.channel_data[i])

            line.set_data(x[-len(y):], y)



        self.axes.relim()

        self.axes.autoscale_view()

        self.canvas.draw_idle()



    def reset_minmax(self):

        self.min_values = self.current_values.copy()

        self.max_values = self.current_values.copy()

        for i, value in enumerate(self.current_values):

            if value is None:

                self.minmax_vars[i].set("MIN --  |  MAX --")

            else:

                self.minmax_vars[i].set(f"MIN {value:.3f}  |  MAX {value:.3f}")



    def toggle_logging(self):

        if self.logging_enabled:

            self.stop_logging()

            return



        default_name = f"gas_log_{datetime.now():%Y%m%d_%H%M%S}.csv"

        path = filedialog.asksaveasfilename(

            title="CSV 저장 위치",

            defaultextension=".csv",

            initialfile=default_name,

            filetypes=[("CSV 파일", "*.csv")]

        )

        if not path:

            return



        try:

            self.log_file = open(path, "w", newline="", encoding="utf-8-sig")

            self.log_writer = csv.writer(self.log_file)

            self.log_writer.writerow(

                ["datetime"] +

                [

                    f"{self.config_data['channel_names'][i]} ({self.config_data['channel_units'][i]})"

                    for i in range(4)

                ]

            )

            self.logging_enabled = True

            self.last_log_time = 0.0

            self.log_btn.config(text="CSV 기록 중지")

            self.status_var.set(f"기록 중: {path}")

        except Exception as exc:

            messagebox.showerror("파일 오류", str(exc))



    def write_log_if_needed(self, values):

        if not self.logging_enabled or not self.log_writer:

            return

        now = time.time()

        interval = float(self.config_data.get("log_interval_sec", 1.0))

        if now - self.last_log_time < interval:

            return

        self.last_log_time = now

        self.log_writer.writerow([datetime.now().isoformat(timespec="milliseconds")] + values[:4])

        self.log_file.flush()



    def stop_logging(self):

        self.logging_enabled = False

        if self.log_file:

            self.log_file.close()

        self.log_file = None

        self.log_writer = None

        self.log_btn.config(text="CSV 기록 시작")

        self.status_var.set("CSV 기록 종료")



    def open_settings(self):

        win = tk.Toplevel(self)

        win.title("채널 설정")

        win.transient(self)

        win.grab_set()



        entries = []

        headers = ["채널명", "단위", "하한 경보", "상한 경보"]

        for c, header in enumerate(headers):

            ttk.Label(win, text=header).grid(row=0, column=c, padx=8, pady=8)



        for i in range(4):

            row_entries = []

            defaults = [

                self.config_data["channel_names"][i],

                self.config_data["channel_units"][i],

                str(self.config_data["alarm_low"][i]),

                str(self.config_data["alarm_high"][i]),

            ]

            for c, value in enumerate(defaults):

                entry = ttk.Entry(win, width=18)

                entry.insert(0, value)

                entry.grid(row=i + 1, column=c, padx=8, pady=5)

                row_entries.append(entry)

            entries.append(row_entries)



        ttk.Label(win, text="그래프 저장 포인트").grid(row=5, column=0, padx=8, pady=8, sticky="e")

        points_entry = ttk.Entry(win, width=18)

        points_entry.insert(0, str(self.config_data["graph_points"]))

        points_entry.grid(row=5, column=1, padx=8, pady=8)



        ttk.Label(win, text="CSV 기록 간격(초)").grid(row=5, column=2, padx=8, pady=8, sticky="e")

        log_entry = ttk.Entry(win, width=18)

        log_entry.insert(0, str(self.config_data["log_interval_sec"]))

        log_entry.grid(row=5, column=3, padx=8, pady=8)



        def apply():

            try:

                names, units, lows, highs = [], [], [], []

                for row in entries:

                    names.append(row[0].get().strip() or "CH")

                    units.append(row[1].get().strip())

                    lows.append(float(row[2].get()))

                    highs.append(float(row[3].get()))

                graph_points = int(points_entry.get())

                log_interval = float(log_entry.get())

                if graph_points < 20:

                    raise ValueError("그래프 포인트는 20 이상이어야 합니다.")

                if log_interval <= 0:

                    raise ValueError("기록 간격은 0보다 커야 합니다.")



                self.config_data.update({

                    "channel_names": names,

                    "channel_units": units,

                    "alarm_low": lows,

                    "alarm_high": highs,

                    "graph_points": graph_points,

                    "log_interval_sec": log_interval,

                })

                save_config(self.config_data)



                for i in range(4):

                    self.card_frames[i].config(text=names[i])

                    self.card_frames[i].unit_label.config(text=units[i])

                    self.plot_lines[i].set_label(names[i])



                self.axes.legend(loc="upper left")

                self.canvas.draw_idle()

                win.destroy()

            except Exception as exc:

                messagebox.showerror("설정 오류", str(exc), parent=win)



        ttk.Button(win, text="저장", command=apply).grid(

            row=6, column=0, columnspan=4, pady=12

        )



    def on_close(self):

        self.disconnect_serial()

        self.stop_logging()

        self.destroy()





if __name__ == "__main__":

    app = GasMonitorApp()

    app.mainloop() 

