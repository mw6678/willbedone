# ==========================================
# 📥 [수신 데이터 파싱 및 보정 영역] (★여기서 수정하세요★)
# ==========================================
def parse_custom_data(raw_data):
    """콤마(,)로 구분된 2개의 데이터를 파싱하고 필요시 수치를 보정합니다."""
    try:
        parts = raw_data.replace(" ", "").split(',')
        if len(parts) >= 2:
            
            # 1️⃣ 센서에서 들어오는 순서 설정
            # 첫 번째 값(parts[0]) = 온도 / 두 번째 값(parts[1]) = 습도 
            raw_temp = float(parts[0])
            raw_humi = float(parts[1])
            
            # 2️⃣ 데이터 수치 보정 (가중치 / 오프셋)
            # 온도는 소수점 1자리까지(float), 습도는 정수(int)로 처리합니다.
            temp = raw_temp * 1.0       # 온도 보정
            humi = int(raw_humi * 1.0)  # 습도 보정
            
            return temp, humi
            
    except (ValueError, IndexError):
        pass
    
    return None, None


# ==========================================
# 🔍 [자동 포트 검색 (온습도 전용)]
# ==========================================
def auto_detect_port():
    """데이터가 정확히 '2개'씩 들어오는 포트를 온습도 센서로 인식합니다."""
    ports = serial.tools.list_ports.comports()
    for port in ports:
        try:
            with serial.Serial(port.device, BAUD_RATE, timeout=2) as ser:
                for _ in range(3):
                    raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                    if raw_data:
                        parts = raw_data.replace(" ", "").split(',')
                        
                        # 💡 CO2(1개)나 미세먼지(3개 이상)와 구분하기 위해 길이를 2로 제한
                        if len(parts) == 2:
                            try:
                                float(parts[0])
                                float(parts[1])
                                return port.device # 데이터가 정상적인 2개면 포트 확정!
                            except ValueError:
                                pass
        except serial.SerialException:
            pass
            
    return None


# ==========================================
# 🧵 [백그라운드 시리얼 통신 스레드]
# ==========================================
class SerialThread(QThread):
    # 온도(float), 습도(int) 전달 시그널
    data_signal = pyqtSignal(float, int) 

    def run(self):
        port_name = auto_detect_port()
        if port_name is None:
            return

        current_date = ""
        file_path = ""

        try:
            ser = serial.Serial(port_name, BAUD_RATE, timeout=1)
            while not self.isInterruptionRequested():
                if ser.in_waiting > 0:
                    raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                    
                    temp, humi = parse_custom_data(raw_data)

                    if temp is not None and humi is not None:
                        # UI 업데이트 
                        self.data_signal.emit(temp, humi)
                        
                        # CSV 자동 저장 
                        now = datetime.now()
                        today_str = now.strftime("%Y-%m-%d")
                        time_str = now.strftime("%H:%M:%S")

                        if current_date != today_str:
                            current_date = today_str
                            file_path = os.path.join(BASE_DIR, f"TempHumi_log_{current_date}.csv")
                            if not os.path.exists(file_path):
                                with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                    writer = csv.writer(f)
                                    writer.writerow(["측정일자", "측정시간", "온도 (℃)", "습도 (%)"])

                        try:
                            with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                writer = csv.writer(f)
                                writer.writerow([today_str, time_str, temp, humi])
                        except PermissionError:
                            pass
                QThread.msleep(100) 

        except serial.SerialException:
            pass
        finally:
            if 'ser' in locals() and ser.is_open:
                ser.close()


