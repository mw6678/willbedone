# 🔍 [메인 어플리케이션 및 윈도우 클래스]
# ==========================================
class TempHumiMonitorApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.initUI()
        self.start_thread()
        self.dragPos = QPoint()

    def initUI(self):
        self.setWindowTitle("온습도 모니터링")
        self.resize(500, 300)  # 2개가 나란히 들어가도록 너비 조절
        self.setStyleSheet("QMainWindow { background-color: white; border: 1px solid #CCCCCC;}")
        
        self.setWindowFlags(Qt.FramelessWindowHint)

        central_widget = QWidget()
        self.setCentralWidget(central_widget)

        main_layout = QHBoxLayout(central_widget)
        main_layout.setContentsMargins(15, 15, 15, 15)
        main_layout.setSpacing(15)

        # 이미지 순서에 맞춰 왼쪽=습도(정수), 오른쪽=온도(소수점 1자리)
        self.humi_widget = SensorLevelWidget("습도", "%", HUMI_LEVELS, decimal_places=0)
        self.temp_widget = SensorLevelWidget("온도", "℃", TEMP_LEVELS, decimal_places=1)

        # 레이아웃에 추가 (좌: 습도, 우: 온도)
        main_layout.addWidget(self.humi_widget)
        main_layout.addWidget(self.temp_widget)

    def start_thread(self):
        self.serial_thread = SerialThread()
        self.serial_thread.data_signal.connect(self.update_data)
        self.serial_thread.start()

    def update_data(self, temp, humi):
        # 각각의 위젯 업데이트
        self.temp_widget.update_value(temp)
        self.humi_widget.update_value(humi)

    def closeEvent(self, event):
        if hasattr(self, 'serial_thread'):
            self.serial_thread.requestInterruption()
            self.serial_thread.wait()
        event.accept()

    # ==========================================
    # 🖱️ [마우스 드래그 및 종료 기능]
    # ==========================================
    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.dragPos = event.globalPos()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.LeftButton:
            self.move(self.pos() + event.globalPos() - self.dragPos)
            self.dragPos = event.globalPos()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = TempHumiMonitorApp()
    window.show()
    sys.exit(app.exec_())