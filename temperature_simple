import csv
from datetime import datetime
import sys
import os
import serial
import serial.tools.list_ports
import time
import re
from PyQt5.QtWidgets import (QApplication, QMainWindow, QWidget, QVBoxLayout, QLabel)
from PyQt5.QtCore import QThread, pyqtSignal, Qt, QPoint
from PyQt5.QtGui import QFont

# ==========================================
#  [사용자 설정 영역]
# ==========================================
BAUD_RATE = 9600

if getattr(sys, 'frozen', False):
    BASE_DIR = os.path.dirname(sys.executable)
else:
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# ==========================================
#  [수신 데이터 파싱 (온도, 습도 전용)]
# ==========================================
def parse_custom_data(raw_data):
    """문자열에서 숫자 2개(온도, 습도)를 추출합니다."""
    if not raw_data:
        return None

    try:
        numbers = re.findall(r"[-+]?\d*\.\d+|\d+", raw_data)
        
        # 💡 숫자가 2개 이상 들어오지 않으면 무시
        if len(numbers) < 2:
            return None
            
        temp = float(numbers[0])
        hum = float(numbers[1])
        
        #  논리적 범위 필터링 (-50~100도, 0~100%)
        if (temp < -50 or temp > 100) or (hum < 0 or hum > 100):
            return None
            
        return temp, hum
        
    except Exception:
        pass
    
    return None

# ==========================================
#  [자동 포트 검색 - VID/PID 방식]
# ==========================================
def auto_detect_port():
    ports = serial.tools.list_ports.comports()
    if not ports:
        return None
        
    # 사용 중인 센서의 VID/PID 입력
    TARGET_VID = 0x0148
    TARGET_PID = 0x4000
    
    for port in ports:
        if port.vid == TARGET_VID and port.pid == TARGET_PID:
            return port.device
            
    return None

# ==========================================
#  [백그라운드 시리얼 통신 스레드]
# ==========================================
class SerialThread(QThread):
    #  온도(float), 습도(float) 2개의 값을 전달
    data_signal = pyqtSignal(float, float)
    error_signal = pyqtSignal(str)

    def safe_sleep(self, ms):
        for _ in range(ms // 100):
            if self.isInterruptionRequested():
                return  
            QThread.msleep(100)

    def write_log(self, message):
        log_dir = os.path.join(BASE_DIR, "Logs")
        if not os.path.exists(log_dir):
            os.makedirs(log_dir)
            
        log_file = os.path.join(log_dir, "error_log.txt")
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        try:
            with open(log_file, "a", encoding="utf-8") as f:
                f.write(f"{timestamp}\n{message}\n")
        except Exception:
            pass

    def run(self):
        current_date = ""
        file_path = ""
        last_save_time = 0
        is_connected = False
        last_port = "Unknown"

        while not self.isInterruptionRequested():
            
            port_name = auto_detect_port()
            
            if port_name is None:
                if is_connected:
                    self.write_log(f"Serial {last_port} disconnected")
                    self.write_log("Reconnecting...")
                    is_connected = False
                    
                self.error_signal.emit("센서 탐색 중...")
                self.safe_sleep(2000)  
                continue

            try:
                ser = serial.Serial(port_name, BAUD_RATE, timeout=1)
                last_port = port_name
                
                if not is_connected:
                    self.write_log(f"Serial {port_name} connected")
                    is_connected = True
                
                self.error_signal.emit("센서 초기화 중...")
                init_start_time = time.time()
                last_data_time = time.time()
                
                while ser.is_open and not self.isInterruptionRequested():
                    sensor_values = None
                    current_time = time.time()
                    
                    while ser.in_waiting > 0:
                        raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                        parsed = parse_custom_data(raw_data)
                        if parsed is not None:
                            sensor_values = parsed  
                            last_data_time = current_time 

                    if current_time - last_data_time >= 30.0:
                        self.error_signal.emit("센서 데이터 없음 (확인 요망)")
                        
                    elif sensor_values is not None:
                        if current_time - init_start_time < 3.0:
                            pass 
                        else:
                            temp, hum = sensor_values
                            
                            self.data_signal.emit(temp, hum)
                            
                            if current_time - last_save_time >= 1.0:
                                last_save_time = current_time
                                
                                now = datetime.now()
                                today_str = now.strftime("%Y-%m-%d")
                                time_str = now.strftime("%H:%M:%S")

                                if current_date != today_str:
                                    current_date = today_str
                                    
                                    save_dir = os.path.join(BASE_DIR, "CSV_Logs")
                                    if not os.path.exists(save_dir):
                                        os.makedirs(save_dir)
                                        
                                    file_path = os.path.join(save_dir, f"TempHum_log_{current_date}.csv")
                                    
                                    if not os.path.exists(file_path):
                                        with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                            writer = csv.writer(f)
                                            #  CSV 헤더 변경 (온습도 전용)
                                            writer.writerow(["측정일자", "측정시간", "온도 (°C)", "습도 (%)"])

                                try:
                                    with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                        writer = csv.writer(f)
                                        writer.writerow([today_str, time_str, temp, hum])
                                except PermissionError:
                                    pass
                    
                    self.safe_sleep(100) 

            except serial.SerialException:
                if is_connected:
                    self.write_log(f"Serial {last_port} disconnected")
                    self.write_log("Reconnecting...")
                    is_connected = False
                    
                self.error_signal.emit("연결 끊김 (재연결 중)")
                pass
            finally:
                if 'ser' in locals() and ser is not None and ser.is_open:
                    ser.close()
            
            self.safe_sleep(2000)  

# ==========================================
#  [온습도 전용 UI 위젯]
# ==========================================
class SensorWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.initUI()

    def initUI(self):
        self.setStyleSheet("background-color: white;")
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(20, 20, 20, 20)
        main_layout.setSpacing(15)

        # 1. 타이틀
        title_label = QLabel("온습도 실시간 모니터링")
        title_label.setFont(QFont("Malgun Gothic", 14, QFont.Bold))
        title_label.setAlignment(Qt.AlignCenter)
        title_label.setStyleSheet("color: #333333;")
        main_layout.addWidget(title_label)
        
        main_layout.addSpacing(10)

        # 2. 온도 표시 (크게)
        self.temp_label = QLabel("--.- °C")
        self.temp_label.setFont(QFont("Arial", 36, QFont.Bold))
        self.temp_label.setAlignment(Qt.AlignCenter)
        self.temp_label.setStyleSheet("color: #E53935;") 
        main_layout.addWidget(self.temp_label)
        
        # 3. 습도 표시 (크게)
        self.hum_label = QLabel("--.- %")
        self.hum_label.setFont(QFont("Arial", 36, QFont.Bold))
        self.hum_label.setAlignment(Qt.AlignCenter)
        self.hum_label.setStyleSheet("color: #1E88E5;") 
        main_layout.addWidget(self.hum_label)
        
        main_layout.addStretch(1)

        # 4. 상태 텍스트
        self.status_text_label = QLabel("대기 중...")
        self.status_text_label.setFont(QFont("Malgun Gothic", 14, QFont.Bold))
        self.status_text_label.setAlignment(Qt.AlignCenter)
        self.status_text_label.setFixedHeight(40)
        self.status_text_label.setStyleSheet("background-color: #E0E0E0; border-radius: 8px; color: gray;")
        main_layout.addWidget(self.status_text_label)

    def update_data(self, temp, hum):
        self.temp_label.setText(f" {temp:.1f} °C")
        self.hum_label.setText(f" {hum:.1f} %")
        
        # 데이터가 정상적으로 들어오면 상태창을 초록색(정상)으로 변경
        self.status_text_label.setText("정상 측정 중")
        self.status_text_label.setStyleSheet("background-color: #28A745; border-radius: 8px; color: white;")

    def set_error_state(self, msg):
        """연결 끊김 시 초기화 및 에러 표시"""
        self.temp_label.setText(" --.- °C")
        self.hum_label.setText(" --.- %")
        
        self.status_text_label.setText(msg)
        self.status_text_label.setStyleSheet("background-color: #FFCDD2; border-radius: 8px; color: #B71C1C;")

# ==========================================
#  [메인 GUI 클래스]
# ==========================================
class MonitorApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.initUI()
        self.start_thread()
        self.dragPos = QPoint()

    def initUI(self):
        self.setWindowTitle("온습도 모니터링")
        # 온습도 표시에 최적화된 창 크기 (약간 좁고 길게)
        self.resize(280, 320) 
        self.setStyleSheet("QMainWindow { background-color: white; border: 1px solid #CCCCCC; }") 
        self.setWindowFlags(Qt.FramelessWindowHint)

        self.sensor_widget = SensorWidget()
        self.setCentralWidget(self.sensor_widget)

    def start_thread(self):
        self.serial_thread = SerialThread()
        self.serial_thread.data_signal.connect(self.update_data)
        self.serial_thread.error_signal.connect(self.handle_error) 
        self.serial_thread.start()

    def update_data(self, temp, hum):
        self.sensor_widget.update_data(temp, hum)

    def handle_error(self, error_msg):
        self.sensor_widget.set_error_state(error_msg)

    def closeEvent(self, event):
        if hasattr(self, 'serial_thread'):
            self.serial_thread.requestInterruption()
            self.serial_thread.wait(1000) 
        event.accept()

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.dragPos = event.globalPos()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.LeftButton:
            self.move(self.pos() + event.globalPos() - self.dragPos)
            self.dragPos = event.globalPos()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MonitorApp()
    window.show()
    sys.exit(app.exec_())