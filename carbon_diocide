# ⚙️ [사용자 설정 영역]
# ==========================================
BAUD_RATE = 9600  # 시리얼 통신 보드레이트 설정

if getattr(sys, 'frozen', False):
    BASE_DIR = os.path.dirname(sys.executable)
else:
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))


# ==========================================
# 📥 [수신 데이터 파싱 커스텀 함수]
# ==========================================
def parse_custom_data(raw_data):
    """콤마(,)로 구분된 데이터 중 첫 번째 값을 CO2 수치로 파싱합니다."""
    try:
        parts = raw_data.replace(" ", "").split(',')
        
        if len(parts) >= 1:
            raw_co2 = int(parts[0])
            co2 = int(raw_co2 * 1.0)  # 보정 계수 적용 (필요 시 조정 가능)
            return co2
            
    except (ValueError, IndexError):
        pass
        
    return None


# ==========================================
# 🔍 [자동 포트 검색 함수]
# ==========================================
def auto_detect_port():
    """시스템에 연결된 시리얼 포트 중 USB/UART 관련 포트를 자동 탐색합니다."""
    ports = serial.tools.list_ports.comports()
    if not ports:
        return None
    for port in ports:
        description = port.description.upper()
        if any(keyword in description for keyword in ["USB", "UART", "CH340", "CP210", "SERIAL"]):
            return port.device
    return ports[0].device


# ==========================================
# 🧵 [백그라운드 시리얼 통신 및 CSV 자동 저장 스레드]
# ==========================================
class SerialThread(QThread):
    status_signal = pyqtSignal(str)          # 연결 상태 메시지 전달 시그널
    data_signal = pyqtSignal(int)            # 측정된 CO2 데이터 전달 시그널 (int 1개)

    def run(self):
        port_name = auto_detect_port()

        if port_name is None:
            self.status_signal.emit("❌ 센서를 찾을 수 없습니다.")
            return

        current_date = ""
        file_path = ""

        try:
            ser = serial.Serial(port_name, BAUD_RATE, timeout=1)
            self.status_signal.emit(f"✅ 연결됨: {port_name}")

            while not self.isInterruptionRequested():
                if ser.in_waiting > 0:
                    raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                    co2 = parse_custom_data(raw_data)

                    if co2 is not None:
                        self.data_signal.emit(co2)

                        now = datetime.now()
                        today_str = now.strftime("%Y-%m-%d")
                        time_str = now.strftime("%H:%M:%S")

                        if current_date != today_str:
                            current_date = today_str
                            file_path = os.path.join(BASE_DIR, f"CO2_log_{current_date}.csv")
                            
                            is_new_file = not os.path.exists(file_path)
                            if is_new_file:
                                with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                    writer = csv.writer(f)
                                    writer.writerow(["측정일자", "측정시간", "CO2 (ppm)"])

                        try:
                            with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                writer = csv.writer(f)
                                writer.writerow([today_str, time_str, co2])
                        except PermissionError:
                            pass
                
                QThread.msleep(100) 

        except serial.SerialException:
            self.status_signal.emit(f"❌ 포트({port_name}) 접근 거부됨 (사용중)")
        finally:
            if 'ser' in locals() and ser.is_open:
                ser.close()


# ==========================================
# 🖥️ [CO2 레벨 표시 위젯]
# ==========================================
class CO2LevelWidget(QWidget):
    # 레벨 데이터 (분류 기준, 색상)
    LEVELS = [
        {"name": "좋음", "min": 0, "max": 500, "color": "#00C853"},  # Green
        {"name": "보통", "min": 501, "max": 1000, "color": "#FFD700"},       # Yellow
        {"name": "민감군", "min": 1001, "max": 3000, "color": "#FD7E14"},      # Orange
        {"name": "나쁨", "min": 3001, "max": 5000, "color": "#DC3545"},     # Red
        {"name": "매우 나쁨", "min": 5001, "max": 10000, "color": "#800080"}, # Purple
        {"name": "위험", "min": 10001, "max": 30000, "color": "#795548"},      # Brown
    ]

    def __init__(self, parent=None):
        super().__init__(parent)
        self.current_value = 400 # 초기 수치 저장용
        self.initUI()

    def initUI(self):
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(10)

        # -----------------------------------
        # 상단: CO2 수치 및 단위
        # -----------------------------------
        top_layout = QHBoxLayout()
        top_layout.setContentsMargins(0, 0, 0, 0)
        top_layout.setSpacing(5)

        title_label = QLabel("CO2")
        title_label.setFont(QFont("Arial", 18, QFont.Bold))
        title_label.setStyleSheet("color: #333333;")
        top_layout.addWidget(title_label)
        
        top_layout.addStretch(1)

        self.co2_value_label = QLabel("--")
        self.co2_value_label.setFont(QFont("Arial", 28, QFont.Bold))
        self.co2_value_label.setStyleSheet("color: #333333;")
        self.co2_value_label.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
        top_layout.addWidget(self.co2_value_label)

        ppm_label = QLabel("ppm")
        ppm_label.setFont(QFont("Arial", 12))
        ppm_label.setStyleSheet("color: gray;")
        ppm_label.setAlignment(Qt.AlignBottom)
        ppm_label.setContentsMargins(0, 0, 0, 5)
        top_layout.addWidget(ppm_label)

        main_layout.addLayout(top_layout)

        # -----------------------------------
        # 중단: 화살표 및 레벨 바
        # -----------------------------------
        self.arrow_container = QWidget()
        self.arrow_container.setFixedHeight(20)
        
        self.arrow_label = QLabel("▼")
        self.arrow_label.setFont(QFont("Arial", 12, QFont.Bold))
        self.arrow_label.setStyleSheet("color: #333333;")
        self.arrow_label.setAlignment(Qt.AlignCenter)
        self.arrow_label.setFixedWidth(20)
        self.arrow_label.setParent(self.arrow_container)
        
        main_layout.addWidget(self.arrow_container)

        level_bar_frame = QFrame()
        level_bar_frame.setFrameShape(QFrame.NoFrame)
        self.level_bar_layout = QHBoxLayout(level_bar_frame)
        self.level_bar_layout.setContentsMargins(0, 0, 0, 0)
        self.level_bar_layout.setSpacing(4) # 바 사이 간격 조정

        self.level_bars = []
        for level in self.LEVELS:
            bar = QFrame()
            bar.setFixedHeight(15)
            bar.setStyleSheet(f"background-color: {level['color']}; border-radius: 4px;")
            self.level_bars.append(bar)
            self.level_bar_layout.addWidget(bar)

        main_layout.addWidget(level_bar_frame)

        # -----------------------------------
        # 하단: 상태 텍스트
        # -----------------------------------
        self.status_text_label = QLabel("대기 중...")
        self.status_text_label.setFont(QFont("Malgun Gothic", 12, QFont.Bold))
        self.status_text_label.setAlignment(Qt.AlignCenter)
        self.status_text_label.setFixedHeight(30)
        self.status_text_label.setStyleSheet("background-color: #F8F9FA; border-radius: 4px; color: gray;")
        
        main_layout.addWidget(self.status_text_label)

    def update_co2(self, value):
        """CO2 수치를 업데이트하고 상태 텍스트를 갱신합니다."""
        self.current_value = value
        self.co2_value_label.setText(str(value))

        # 현재 수치에 맞는 레벨 단계 찾기
        current_level = None
        for level in self.LEVELS:
            if value <= level['max']:
                current_level = level
                break
        
        if value < self.LEVELS[0]['min']:
            current_level = self.LEVELS[0]
        elif value > self.LEVELS[-1]['max']:
            current_level = self.LEVELS[-1]

        if current_level:
            # 텍스트와 배경색 업데이트
            self.status_text_label.setText(current_level['name'])
            color = current_level['color']
            
            qcolor = QColor(color)
            if qcolor.lightness() > 150: 
                self.status_text_label.setStyleSheet(f"background-color: {color}; border-radius: 4px; color: black; padding: 5px;")
            else: 
                self.status_text_label.setStyleSheet(f"background-color: {color}; border-radius: 4px; color: white; padding: 5px;")

        # 화살표 위치 계산 함수 호출
        self.update_arrow_position()

    def update_arrow_position(self):
        """현재 CO2 수치를 바탕으로 화살표의 위치를 정밀하게 계산하여 이동시킵니다."""
        if not self.level_bars or self.level_bars[0].geometry().width() == 0:
            return # UI가 완전히 렌더링 되기 전이면 스킵

        value = self.current_value
        
        # 1. 값이 어느 구간(인덱스)에 속하는지 파악
        level_index = 0
        for i, level in enumerate(self.LEVELS):
            if value <= level['max']:
                level_index = i
                break
        else:
            level_index = len(self.LEVELS) - 1

        current_level = self.LEVELS[level_index]
        level_min = current_level['min']
        level_max = current_level['max']

        # 2. 해당 구간(블록) 안에서 몇 % 지점에 위치하는지 계산
        if value <= level_min:
            ratio = 0.0
        elif value >= level_max:
            ratio = 1.0
        else:
            ratio = (value - level_min) / (level_max - level_min)

        # 3. 목표 블록의 화면상 X 좌표와 너비 가져오기
        target_bar = self.level_bars[level_index]
        bar_x = target_bar.geometry().x()
        bar_width = target_bar.geometry().width()

        # 4. 최종 X 좌표 계산 (해당 블록의 시작점 + (블록 너비 * 비율))
        target_x = bar_x + (bar_width * ratio)

        # 5. 화살표 중앙이 목표지점에 오도록 조정
        arrow_x = target_x - (self.arrow_label.width() / 2)
        
        # Y축은 화살표 컨테이너 바닥에 맞게 고정
        arrow_y = self.arrow_container.height() - self.arrow_label.height()

        self.arrow_label.move(QPoint(int(arrow_x), int(arrow_y)))

    def resizeEvent(self, event):
        """창 크기가 변할 때 화살표 위치를 재계산합니다."""
        super().resizeEvent(event)
        self.update_arrow_position()
        
