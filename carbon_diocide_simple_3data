BAUD_RATE = 9600

# 여기에 장치 관리자에서 확인한 COM 포트 번호들을 적어주세요!
TARGET_PORTS = ["COM9", "COM10"] #[cite: 1]

if getattr(sys, 'frozen', False):
    BASE_DIR = os.path.dirname(sys.executable)
else:
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# ==========================================
#  [수신 데이터 파싱 - 센서별 보정값 적용 및 예외 처리]
# ==========================================
def parse_custom_data(raw_data, sensor_index): #[cite: 1]
    if not raw_data:
        return None

    try:
        numbers = re.findall(r"[-+]?\d*\.\d+|\d+", raw_data) #[cite: 1]
        if not numbers:
            return None

        raw_co2 = float(numbers[0]) 
        co2_value = None

        # 💡 센서별 파싱값(보정) 수정 영역
        if sensor_index == 0:
            co2_value = int(raw_co2 * 1.0)
        elif sensor_index == 1:
            co2_value = int(raw_co2 * 1.0)
        elif sensor_index == 2:
            co2_value = int(raw_co2 * 1.0)
        else:
            co2_value = int(raw_co2 * 1.0)

        # 논리적 범위 필터링 (Safety Check)
        if co2_value is not None:
            if co2_value < 0 or co2_value > 30000: # (범위 30000으로 넉넉하게 수정)
                return None  
            return co2_value

    except Exception:
        pass
        
    return None

# ==========================================
#  [백그라운드 개별 통신 스레드]
# ==========================================
class SerialThread(QThread):
    data_signal = pyqtSignal(int, int) 
    error_signal = pyqtSignal(int, str) 

    def __init__(self, port_name, sensor_index): 
        super().__init__()
        self.port_name = port_name
        self.sensor_index = sensor_index
        
        # 💡 [스무딩 설정] 최근 몇 개의 데이터를 모아서 평균을 낼지 결정 (기본 5개)
        self.smoothing_window = 3
        self.data_buffer = [] 

    def safe_sleep(self, ms): 
        for _ in range(ms // 100):
            if self.isInterruptionRequested():
                return  
            QThread.msleep(100)

    def write_log(self, message): 
        log_dir = os.path.join(BASE_DIR, "Logs")
        if not os.path.exists(log_dir):
            os.makedirs(log_dir)
            
        log_file = os.path.join(log_dir, f"error_log_Sensor{self.sensor_index + 1}.txt")
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        try:
            with open(log_file, "a", encoding="utf-8") as f:
                f.write(f"{timestamp} | 포트: {self.port_name} | {message}\n")
        except Exception:
            pass

    def run(self):
        current_date = ""
        file_path = ""
        last_save_time = 0  
        is_connected = False 
        is_no_data_error_sent = False 

        while not self.isInterruptionRequested(): 
            try:
                ser = serial.Serial(self.port_name, BAUD_RATE, timeout=1)
                
                if not is_connected: 
                    self.write_log("통신 연결 성공")
                    is_connected = True
                    self.data_buffer.clear() # 💡 연결 시 이전 버퍼 비우기

                init_start_time = time.time()
                last_data_time = time.time()

                while ser.is_open and not self.isInterruptionRequested():
                    raw_co2_value = None
                    current_time = time.time()

                    while ser.in_waiting > 0:
                        raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                        parsed = parse_custom_data(raw_data, self.sensor_index)
                        if parsed is not None:
                            raw_co2_value = parsed
                            last_data_time = current_time 
                            is_no_data_error_sent = False 

                    # 30초 이상 데이터가 없을 때 에러 전송
                    if current_time - last_data_time >= 30.0:
                        if not is_no_data_error_sent:
                            self.error_signal.emit(self.sensor_index, "데이터 없음")
                            is_no_data_error_sent = True
                            self.data_buffer.clear() #  데이터 끊김 시 버퍼 비우기

                    #  정상적인 데이터를 수신했을 때 스무딩(평균) 처리
                    elif raw_co2_value is not None and raw_co2_value !=0:
                        # 통신 연결 직후 3초간의 초기 노이즈값 무시
                        if current_time - init_start_time >= 3.0: 
                            
                            # 1. 버퍼에 새 데이터 추가
                            self.data_buffer.append(raw_co2_value)
                            
                            # 2. 버퍼 크기가 설정값을 초과하면 가장 오래된 데이터 삭제
                            if len(self.data_buffer) > self.smoothing_window:
                                self.data_buffer.pop(0)
                                
                            # 3. 버퍼에 있는 데이터들의 평균값 계산 (정수로 변환)
                            smoothed_co2 = int(sum(self.data_buffer) / len(self.data_buffer))

                            # 💡 원본(raw) 값이 아닌, 평균(smoothed) 값을 UI로 전송
                            self.data_signal.emit(self.sensor_index, smoothed_co2) 

                            # 1초에 한 번만 CSV 파일에 쓰기
                            if current_time - last_save_time >= 1.0:
                                last_save_time = current_time
                                
                                now = datetime.now()
                                today_str = now.strftime("%Y-%m-%d")
                                time_str = now.strftime("%H:%M:%S")

                                save_dir = os.path.join(BASE_DIR, "CSV_Logs") 
                                if not os.path.exists(save_dir):
                                    os.makedirs(save_dir)

                                if current_date != today_str:
                                    current_date = today_str
                                    file_path = os.path.join(save_dir, f"CO2_log_{current_date}_Sensor{self.sensor_index + 1}.csv") 
                                    if not os.path.exists(file_path):
                                        with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                            writer = csv.writer(f)
                                            writer.writerow(["측정일자", "측정시간", f"포트({self.port_name}) CO2 (ppm)"])

                                try:
                                    file_path = os.path.join(save_dir, f"CO2_log_{current_date}_Sensor{self.sensor_index + 1}.csv")
                                    with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                        writer = csv.writer(f)
                                        # 💡 CSV에도 평균(smoothed) 값을 기록
                                        writer.writerow([today_str, time_str, smoothed_co2]) 
                                except PermissionError:
                                    pass 

                    self.safe_sleep(100)

            except serial.SerialException:
                if is_connected: 
                    self.write_log("통신 연결 끊김 (USB 분리 또는 오류)")
                    is_connected = False

                self.data_buffer.clear() #  물리적 연결 끊김 시 버퍼 비우기
                self.error_signal.emit(self.sensor_index, "연결 끊김 (재연결 중)")
            except Exception as e:
                if is_connected:
                    self.write_log(f"알 수 없는 오류 발생: {str(e)}")
                    is_connected = False

                self.data_buffer.clear()
                self.error_signal.emit(self.sensor_index, "시스템 오류 (재연결 중)")
                
            finally:
                # 💡 [수정] 강제로 선이 뽑혔을 때 포트를 닫으려다 발생하는 에러까지 차단
                if 'ser' in locals() and ser is not None and getattr(ser, 'is_open', False): 
                    try:
                        ser.close()
                    except Exception:
                        pass
                
            self.safe_sleep(3000)
