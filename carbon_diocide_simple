# ==========================================
# ⚙️ [사용자 설정 영역]
# ==========================================
BAUD_RATE = 9600

if getattr(sys, 'frozen', False):
    BASE_DIR = os.path.dirname(sys.executable)
else:
    BASE_DIR = os.path.dirname(os.path.abspath(__file__))

# ==========================================
#  [단일 수신 데이터 파싱 (CO2 전용) - 오류 방지 강화]
# ==========================================
def parse_custom_data(raw_data):
    """들어오는 데이터에서 특수문자나 찌꺼기를 걸러내고 순수 숫자만 추출합니다."""
    # 1. 데이터가 비어있으면 바로 무시
    if not raw_data:
        return None

    try:
        # 2. 정규식(Regex)을 사용하여 문자열에 섞인 영문, 특수문자를 무시하고 숫자만 추출
        numbers = re.findall(r"[-+]?\d*\.\d+|\d+", raw_data)
        
        # 숫자를 하나도 찾지 못했다면 쓰레기값이므로 버림
        if not numbers:
            return None
            
        # 3. 추출한 첫 번째 숫자를 실수(float)로 변환 후 정수(int)로 변환
        raw_co2 = float(numbers[0])
        co2 = int(raw_co2 * 1.0)  # 필요 시 1.0 부분을 수정하여 센서값 보정 가능
        
        # 4. 논리적 범위 필터링 (Safety Check)
        # 상식적인 CO2 범위(예: 0 ~ 10000 ppm)를 벗어나면 순간적인 노이즈로 간주하고 무시
        if co2 < 0 or co2 > 30000:
            return None
            
        return co2
        
    except Exception:
        # 변환 중 예상치 못한 에러가 발생해도 프로그램이 뻗지 않고 다음 데이터를 기다림
        pass
    
    return None

# ==========================================
#  [자동 포트 검색 - VID/PID 방식]
# ==========================================
def auto_detect_port():
    ports = serial.tools.list_ports.comports()
    if not ports:
        return None
        
    #  찾아낸 VID와 PID 값을 여기에 입력하세요!
    # (예시: CH340 칩셋인 경우 보통 VID 0x1A86, PID 0x7523 입니다)
    TARGET_VID = 0x1A86
    TARGET_PID = 0x7523
    
    for port in ports:
        # 현재 연결된 포트의 하드웨어 ID가 설정한 값과 정확히 일치하는지 확인
        if port.vid == TARGET_VID and port.pid == TARGET_PID:
            print(f"✅ 센서 발견: {port.device}")
            return port.device
            
    # 일치하는 기기를 찾지 못했을 경우 None 반환
    print("❌ 지정된 VID/PID를 가진 센서를 찾을 수 없습니다.")
    return None

# ==========================================
#  [백그라운드 시리얼 통신 스레드]
# ==========================================
class SerialThread(QThread):
    data_signal = pyqtSignal(int)

    def run(self):
        current_date = ""
        file_path = ""
        last_save_time = 0

        # 💡 [핵심 수정] 스레드가 강제 종료되지 않는 한 무한히 반복하여 재연결을 시도합니다.
        while not self.isInterruptionRequested():
            
            # 1. 매 루프마다 포트를 새로 찾습니다.
            port_name = auto_detect_port()
            
            # 포트를 못 찾았다면 2초 대기 후 처음으로 돌아가 다시 찾습니다.
            if port_name is None:
                QThread.msleep(2000)
                continue

            try:
                # 2. 포트를 찾았다면 연결을 시도합니다.
                ser = serial.Serial(port_name, BAUD_RATE, timeout=1)
                
                # 3. 연결이 유지되는 동안 데이터 읽기 반복
                while ser.is_open and not self.isInterruptionRequested():
                    co2_value = None
                    
                    while ser.in_waiting > 0:
                        raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                        parsed = parse_custom_data(raw_data)
                        if parsed is not None:
                            co2_value = parsed

                    if co2_value is not None:
                        self.data_signal.emit(co2_value)
                        
                        current_time = time.time()
                        if current_time - last_save_time >= 1.0:
                            last_save_time = current_time
                            
                            now = datetime.now()
                            today_str = now.strftime("%Y-%m-%d")
                            time_str = now.strftime("%H:%M:%S")
# 날짜가 바뀌면 새 파일 생성 및 헤더 쓰기
                        if current_date != today_str:
                            current_date = today_str
                            
                            # 💡 [추가된 부분] 'CSV_Logs'라는 저장 폴더 경로 설정 및 자동 생성
                            save_dir = os.path.join(BASE_DIR, "CSV_Logs")
                            if not os.path.exists(save_dir):
                                os.makedirs(save_dir) # 폴더가 없으면 생성
                                
                            # 💡 [수정된 부분] BASE_DIR 대신 새로 만든 save_dir 안에 파일 생성
                            file_path = os.path.join(save_dir, f"CO2_log_{current_date}.csv")
                            
                            if not os.path.exists(file_path):
                                with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                    writer = csv.writer(f)
                                    writer.writerow(["측정일자", "측정시간", "CO2 (ppm)"])

                            try:
                                with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                    writer = csv.writer(f)
                                    writer.writerow([today_str, time_str, co2_value])
                            except PermissionError:
                                pass
                    
                    QThread.msleep(100) 

            except serial.SerialException:
                # 💡 [핵심 수정] 사용 중 USB가 뽑히거나 통신이 끊어지면 여기로 빠져나옵니다.
                # pass 처리 후 finally에서 포트를 닫고, 바깥쪽 while문으로 돌아가 다시 검색을 시작합니다.
                pass
            finally:
                if 'ser' in locals() and ser is not None and ser.is_open:
                    ser.close()
            
            # 통신 에러로 연결이 끊긴 경우 2초 대기 후 재연결 시도
            QThread.msleep(2000)

# ==========================================
#  [CO2 레벨 표시 위젯]
# ==========================================
class CO2LevelWidget(QWidget):
    LEVELS = [
        {"name": "좋음", "min": 0, "max": 500, "color": "#28A745"},        # 초록
        {"name": "보통", "min": 501, "max": 1000, "color": "#FFD700"},        # 노랑
        {"name": "민감군", "min": 1001, "max": 3000, "color": "#FD7E14"},     # 주황
        {"name": "나쁨", "min": 3001, "max": 5000, "color": "#DC3545"},      # 빨강
        {"name": "매우 나쁨", "min": 5001, "max": 10000, "color": "#800080"}, # 보라
        {"name": "위험", "min": 10001, "max": 30000, "color": "#795548"},      # 갈색
    ]

    def __init__(self, parent=None):
        super().__init__(parent)
        self.current_value = 400 
        self.initUI()

    def initUI(self):
        self.setStyleSheet("background-color: white;")
        main_layout = QVBoxLayout(self)
        main_layout.setContentsMargins(20, 20, 20, 20)
        main_layout.setSpacing(5)

        # 1. 타이틀 (이산화탄소)
        title_label = QLabel("이산화탄소")
        title_label.setFont(QFont("Malgun Gothic", 16, QFont.Bold))
        title_label.setAlignment(Qt.AlignCenter)
        title_label.setStyleSheet("color: black;")
        main_layout.addWidget(title_label)
        
        main_layout.addSpacing(5)

        # 2. 수치 및 단위 레이아웃
        value_layout = QHBoxLayout()
        value_layout.setAlignment(Qt.AlignCenter)
        value_layout.setSpacing(2)

        self.co2_value_label = QLabel("----")
        self.co2_value_label.setFont(QFont("Arial", 42, QFont.Bold))
        self.co2_value_label.setStyleSheet("color: black;")
        value_layout.addWidget(self.co2_value_label)

        ppm_label = QLabel("ppm")
        ppm_label.setFont(QFont("Arial", 16, QFont.Bold))
        ppm_label.setStyleSheet("color: black; margin-bottom: 8px;") 
        ppm_label.setAlignment(Qt.AlignBottom)
        value_layout.addWidget(ppm_label)

        main_layout.addLayout(value_layout)
        main_layout.addSpacing(10)

        # 3. 화살표 컨테이너
        self.arrow_container = QWidget()
        self.arrow_container.setFixedHeight(20)
        
        self.arrow_label = QLabel("▼")
        self.arrow_label.setFont(QFont("Arial", 12, QFont.Bold))
        self.arrow_label.setStyleSheet("color: black;")
        self.arrow_label.setAlignment(Qt.AlignCenter)
        self.arrow_label.setFixedWidth(20)
        self.arrow_label.setParent(self.arrow_container)
        
        main_layout.addWidget(self.arrow_container)

        # 4. 게이지 바 
        level_bar_frame = QFrame()
        self.level_bar_layout = QHBoxLayout(level_bar_frame)
        self.level_bar_layout.setContentsMargins(0, 0, 0, 0)
        self.level_bar_layout.setSpacing(2) 

        self.level_bars = []
        for i, level in enumerate(self.LEVELS):
            bar = QFrame()
            bar.setFixedHeight(14)
            
            border_radius = ""
            if i == 0:
                border_radius = "border-top-left-radius: 7px; border-bottom-left-radius: 7px;"
            elif i == len(self.LEVELS) - 1:
                border_radius = "border-top-right-radius: 7px; border-bottom-right-radius: 7px;"
                
            bar.setStyleSheet(f"background-color: {level['color']}; {border_radius}")
            self.level_bars.append(bar)
            self.level_bar_layout.addWidget(bar)

        main_layout.addWidget(level_bar_frame)
        main_layout.addSpacing(15)

        # 5. 상태 텍스트 블록
        self.status_text_label = QLabel("대기 중...")
        self.status_text_label.setFont(QFont("Malgun Gothic", 16, QFont.Bold))
        self.status_text_label.setAlignment(Qt.AlignCenter)
        self.status_text_label.setFixedHeight(45)
        self.status_text_label.setStyleSheet("background-color: #E0E0E0; border-radius: 8px; color: gray;")
        
        main_layout.addWidget(self.status_text_label)
        main_layout.addStretch(1)

    def update_co2(self, value):
        self.current_value = value
        self.co2_value_label.setText(str(value))

        current_level = None
        for level in self.LEVELS:
            if value <= level['max']:
                current_level = level
                break
        
        if value < self.LEVELS[0]['min']: current_level = self.LEVELS[0]
        elif value > self.LEVELS[-1]['max']: current_level = self.LEVELS[-1]

        if current_level:
            self.status_text_label.setText(current_level['name'])
            color = current_level['color']
            
            text_color = "black" if current_level['name'] == "보통" else "white"
            self.status_text_label.setStyleSheet(f"background-color: {color}; border-radius: 8px; color: {text_color};")

        self.update_arrow_position()

    def update_arrow_position(self):
        if not self.level_bars or self.level_bars[0].geometry().width() == 0:
            return 

        value = self.current_value
        
        level_index = 0
        for i, level in enumerate(self.LEVELS):
            if value <= level['max']:
                level_index = i
                break
        else:
            level_index = len(self.LEVELS) - 1

        current_level = self.LEVELS[level_index]
        level_min = current_level['min']
        level_max = current_level['max']

        if value <= level_min: ratio = 0.0
        elif value >= level_max: ratio = 1.0
        else: ratio = (value - level_min) / (level_max - level_min)

        target_bar = self.level_bars[level_index]
        bar_x = target_bar.geometry().x()
        bar_width = target_bar.geometry().width()

        target_x = bar_x + (bar_width * ratio)
        arrow_x = target_x - (self.arrow_label.width() / 2)
        arrow_y = self.arrow_container.height() - self.arrow_label.height()

        self.arrow_label.move(QPoint(int(arrow_x), int(arrow_y)))

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self.update_arrow_position()


# ==========================================
#  [메인 GUI 클래스]
# ==========================================
class CO2MonitorApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.initUI()
        self.start_thread()
        self.dragPos = QPoint()

    def initUI(self):
        self.setWindowTitle("이산화탄소 모니터링")
        self.resize(250, 300) 
        self.setStyleSheet("QMainWindow { background-color: white; border: 1px solid #CCCCCC; }") 

        # 상단 타이틀바 제거
        self.setWindowFlags(Qt.FramelessWindowHint)

        self.co2_widget = CO2LevelWidget()
        self.setCentralWidget(self.co2_widget)

    def start_thread(self):
        self.serial_thread = SerialThread()
        self.serial_thread.data_signal.connect(self.update_data)
        self.serial_thread.start()

    def update_data(self, co2):
        self.co2_widget.update_co2(co2)

    def closeEvent(self, event):
        if hasattr(self, 'serial_thread'):
            self.serial_thread.requestInterruption()
            self.serial_thread.wait()
        event.accept()

    # ==========================================
    #  [마우스 드래그 및 종료 기능]
    # ==========================================
    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.dragPos = event.globalPos()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.LeftButton:
            self.move(self.pos() + event.globalPos() - self.dragPos)
            self.dragPos = event.globalPos()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = CO2MonitorApp()
    window.show()
    sys.exit(app.exec_())