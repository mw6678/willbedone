# 🔍 [메인 어플리케이션 및 윈도우 클래스]
# ==========================================
class DustMonitorApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.initUI()
        self.start_thread()
        self.dragPos = QPoint()

    def initUI(self):
        self.setWindowTitle("미세먼지 통합 모니터링")
        self.resize(750, 320)  # 3개가 나란히 들어갈 수 있는 넉넉한 창 크기
        self.setStyleSheet("QMainWindow { background-color: white; border: 1px solid #CCCCCC;}")
        
        # 상단 타이틀바 제거
        self.setWindowFlags(Qt.FramelessWindowHint)

        central_widget = QWidget()
        self.setCentralWidget(central_widget)

        # 메인 레이아웃을 가로 배치(QHBoxLayout)로 설정
        main_layout = QHBoxLayout(central_widget)
        main_layout.setContentsMargins(15, 15, 15, 15)
        main_layout.setSpacing(15)

        # 3개의 개별 위젯 생성 (미세먼지, 초미세먼지, 극미세먼지)
        self.pm1_widget = DustLevelWidget("미세먼지(PM10)", "µg/m³", PM10_LEVELS)
        self.pm25_widget = DustLevelWidget("초미세먼지(PM2.5)", "µg/m³", PM25_LEVELS)
        self.pm10_widget = DustLevelWidget("극미세먼지(PM1)", "µg/cm³", PM1_LEVELS)

        # 레이아웃에 가로로 순서대로 추가
        main_layout.addWidget(self.pm1_widget)
        main_layout.addWidget(self.pm25_widget)
        main_layout.addWidget(self.pm10_widget)

    def start_thread(self):
        self.serial_thread = SerialThread()
        self.serial_thread.data_signal.connect(self.update_data)
        self.serial_thread.start()

    def update_data(self, pm10, pm25, pm1):
        # 스레드에서 받은 3개의 수치를 각각의 UI 위젯으로 전송하여 업데이트
        self.pm10_widget.update_value(pm10)
        self.pm25_widget.update_value(pm25)
        self.pm1_widget.update_value(pm1)

    def closeEvent(self, event):
        if hasattr(self, 'serial_thread'):
            self.serial_thread.requestInterruption()
            self.serial_thread.wait()
        event.accept()

    # ==========================================
    # 🖱️ [마우스 드래그 창 이동 기능]
    # ==========================================
    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.dragPos = event.globalPos()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.LeftButton:
            self.move(self.pos() + event.globalPos() - self.dragPos)
            self.dragPos = event.globalPos()

    # ==========================================
    # ⌨️ [ESC 키 종료 기능]
    # ==========================================
    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.close()

