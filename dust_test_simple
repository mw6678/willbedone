# 📥 [수신 데이터 파싱 및 보정 영역] (★여기서 수정하세요★)
# ==========================================
def parse_custom_data(raw_data):
    """콤마(,)로 구분된 3개의 데이터를 파싱하고 필요시 수치를 보정합니다."""
    try:
        parts = raw_data.replace(" ", "").split(',')
        if len(parts) >= 3:
            
            # 1️⃣ 센서에서 들어오는 순서 설정
            # 현재: 첫번째(parts[0])=PM1.0, 두번째(parts[1])=PM2.5, 세번째(parts[2])=PM10
            # 순서가 다르다면 아래 0, 1, 2 숫자의 위치를 바꿔주세요.
            raw_pm10 = float(parts[0])
            raw_pm25 = float(parts[1])
            raw_pm1 = float(parts[2])
            
            # 2️⃣ 데이터 수치 보정 (가중치 / 오프셋)
            # 수치가 안 맞으면 곱하기(*)나 더하기(+)를 추가하세요.
            # 예) pm25가 5 높게 나오면: int(raw_pm25 * 1.0 - 5)
            pm10 = int(raw_pm1 * 1.0)
            pm25 = int(raw_pm25 * 1.0)
            pm1 = int(raw_pm10 * 1.0)
            
            # 변환된 값 3개를 스레드로 전달
            return pm10, pm25, pm1
            
    except (ValueError, IndexError):
        pass
    
    return None, None, None


# ==========================================
# 🔍 [미세먼지 전용 자동 포트 검색]
# ==========================================
def auto_detect_port():
    """시스템에 연결된 포트들을 하나씩 열어보고, 데이터가 3개씩 들어오는 포트를 찾습니다."""
    ports = serial.tools.list_ports.comports()
    
    for port in ports:
        try:
            # 포트를 임시로 열어서 데이터 확인 (타임아웃 설정)
            with serial.Serial(port.device, BAUD_RATE, timeout=2) as ser:
                # 통신을 시작하자마자 읽으면 데이터가 중간부터 잘려 들어올 수 있으므로,
                # 최대 3줄(3번)까지 읽어보면서 정상적인 형태인지 테스트합니다.
                for _ in range(3):
                    raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                    
                    if raw_data:
                        parts = raw_data.replace(" ", "").split(',')
                        
                        # 💡 콤마로 구분된 데이터가 3개 이상인지 확인
                        if len(parts) >= 3:
                            try:
                                # 정상적인 숫자로 변환이 가능한지 테스트
                                float(parts[0])
                                float(parts[1])
                                float(parts[2])
                                
                                # 모든 조건을 통과하면 이 포트가 미세먼지 센서가 맞음!
                                return port.device 
                            except ValueError:
                                pass
        except serial.SerialException:
            # 이미 다른 프로그램(예: CO2 프로그램)이 사용 중이거나 
            # 접근 권한이 없는 포트는 무시하고 다음 포트로 넘어갑니다.
            pass
            
    return None # 맞는 포트를 찾지 못한 경우


# ==========================================
# 🧵 [백그라운드 시리얼 통신 및 CSV 자동저장 스레드]
# ==========================================
class SerialThread(QThread):
    # 3개의 정수형 데이터(PM10, PM2.5, PM1)를 UI로 보내는 시그널
    data_signal = pyqtSignal(int, int, int) 

    def run(self):
        port_name = auto_detect_port()
        if port_name is None:
            return

        current_date = ""
        file_path = ""

        try:
            ser = serial.Serial(port_name, BAUD_RATE, timeout=1)
            while not self.isInterruptionRequested():
                if ser.in_waiting > 0:
                    raw_data = ser.readline().decode("utf-8", errors="ignore").strip()
                    
                    # 파싱 함수를 통해 3개의 값 받아오기
                    pm1, pm25, pm10 = parse_custom_data(raw_data)

                    # 정상적으로 데이터가 파싱되었다면
                    if pm1 is not None and pm25 is not None and pm10 is not None:
                        # 1. UI 업데이트 시그널 전송
                        self.data_signal.emit(pm1, pm25, pm10)
                        
                        # 2. CSV 파일 자동 저장 로직
                        now = datetime.now()
                        today_str = now.strftime("%Y-%m-%d")
                        time_str = now.strftime("%H:%M:%S")

                        if current_date != today_str:
                            current_date = today_str
                            file_path = os.path.join(BASE_DIR, f"Dust_log_{current_date}.csv")
                            if not os.path.exists(file_path):
                                with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                    writer = csv.writer(f)
                                    writer.writerow(["측정일자", "측정시간", "PM 10", "PM 2.5", "PM 1.0"])

                        try:
                            with open(file_path, mode='a', newline='', encoding='utf-8-sig') as f:
                                writer = csv.writer(f)
                                writer.writerow([today_str, time_str, pm10, pm25, pm1])
                        except PermissionError:
                            pass
                
                QThread.msleep(100) 

        except serial.SerialException:
            pass
        finally:
            if 'ser' in locals() and ser.is_open:
                ser.close()


